{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investeringskompassen.local/contracts/snapshot.schema.json",
  "title": "Snapshot",
  "description": "All användardata. Används för backup-fil och (krypterat) för synk. Implementeras av src/core/snapshot.js. Sammanslagning: transaktioner unioneras på id, övrigt 'senast ändrad (updatedAt) vinner' per post. Borttagning = post med deleted: true.",
  "type": "object",
  "required": ["schemaVersion", "transactions", "prices", "watchlist", "instruments", "targets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transactions": { "type": "array", "items": { "$ref": "transaction.schema.json" } },
    "prices": {
      "type": "object",
      "description": "Manuella kurser i SEK per instrumentnyckel",
      "additionalProperties": {
        "type": "object", "required": ["price", "date", "updatedAt"],
        "properties": { "price": { "type": "number" }, "date": { "type": "string" }, "source": { "const": "manual" }, "deleted": { "type": "boolean" }, "updatedAt": { "type": "number" } }
      }
    },
    "watchlist": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "updatedAt"],
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string", "maxLength": 100 }, "current": { "type": ["number", "null"] },
          "target": { "type": ["number", "null"] }, "note": { "type": "string", "maxLength": 500 }, "added": { "type": "string" },
          "deleted": { "type": "boolean" }, "updatedAt": { "type": "number" }
        }
      }
    },
    "instruments": {
      "type": "object",
      "description": "Användarens klassning per instrumentnyckel",
      "additionalProperties": {
        "type": "object",
        "properties": { "type": { "type": "string" }, "region": { "type": "string" }, "updatedAt": { "type": "number" } }
      }
    },
    "targets": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["type", "region", "holding"] },
        "byMode": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 } } },
        "updatedAt": { "type": "number" }
      }
    }
  }
}
